# Copy to .env and fill in real values. The real .env is never committed.
POSTGRES_USER=library
POSTGRES_PASSWORD=
POSTGRES_DB=library

# php artisan key:generate --show
APP_KEY=
JWT_SECRET=
ADMIN_USERNAME=
ADMIN_PASSWORD=

CORS_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:8000/api/v1

# Build contexts. Default: the repositories cloned side by side.
API_CONTEXT=../test-manager-library-3145556-api
APP_CONTEXT=../test-manager-library-3145556-app

# Demo only (ADR-006): shifts the API clock in days. Keep 0 outside the seeding phase.
CLOCK_OFFSET_DAYS=0
